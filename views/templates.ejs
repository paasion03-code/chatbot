<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Templates</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f4f6f9;
      font-family: Arial, sans-serif;
    }
    .template-card {
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.2s ease-in-out;
      height: 100%;
    }
    .template-card:hover {
      transform: translateY(-5px);
    }
    .template-img {
      max-height: 180px;
      object-fit: cover;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h2 class="text-center mb-4">📜 Templates</h2>

    <div class="d-flex justify-content-end mb-3">
      <a href="/admin/templates/add" class="btn btn-success">➕ Create Template</a>
    </div>

    <div class="row g-4">
      <% if (templates.length === 0) { %>
        <div class="col-12 text-center text-muted">No templates available</div>
      <% } else { %>
        <% templates.forEach((t) => { %>
          <div class="col-md-4">
            <div class="card template-card h-100">
              <% if (t.image_path) { %>
                <img src="<%= t.image_path %>" class="template-img card-img-top" alt="Template Image">
              <% } %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= t.title %></h5>
                <p class="card-text"><%= t.message ? t.message.substring(0, 100) : '' %><%= t.message && t.message.length > 100 ? '...' : '' %></p>
                <% if (t.file_path) { %>
                  <p><a href="<%= t.file_path %>" target="_blank">📎 Download File</a></p>
                <% } %>

                <!-- ✅ Send Template Form -->
                <form action="/admin/templates/send/<%= t.id %>" method="POST" class="mt-auto">
                  <div class="input-group">
                    <select name="recipient" class="form-select" required>
                      <option value="all">📢 All Users</option>
                      <% users.forEach(u => { %>
                        <option value="<%= u.id %>"><%= u.username %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn btn-primary">📤 Send</button>
                  </div>
                </form>
              </div>

              <div class="card-footer d-flex justify-content-between">
                <a href="/admin/templates/edit/<%= t.id %>" class="btn btn-warning btn-sm">✏ Edit</a>
                <a href="/admin/templates/delete/<%= t.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Delete this template?')">🗑 Delete</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="text-center mt-4">
      <a href="/admin/dashboard" class="btn btn-secondary">⬅ Back</a>
    </div>
  </div>
</body>
</html>
