<!DOCTYPE html>
<html>
<head>
  <title>Broadcast Message</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .broadcast-container {
      max-width: 700px;
      margin: 20px auto;
      padding: 20px;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .broadcast-container h2 {
      text-align: center;
      margin-bottom: 20px;
    }
    .success {
      color: green;
      text-align: center;
      margin-bottom: 15px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    select, textarea, input[type="radio"], input[type="checkbox"] {
      margin-top: 5px;
    }
    .user-list {
      border: 1px solid #ccc;
      padding: 10px;
      margin-top: 10px;
      border-radius: 5px;
      max-height: 200px;
      overflow-y: auto;
    }
    button {
      background: #007bff;
      color: #fff;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background: #0056b3;
    }
  </style>
</head>
<body>
  <%- include("layout"); %>

  <div class="broadcast-container">
    <h2>📢 Send Broadcast</h2>

    <% if (message) { %>
      <p class="success"><%= message %></p>
    <% } %>

    <form method="POST" action="/admin/broadcast">
      <!-- Select Template -->
      <div class="form-group">
        <label for="template">Select Template:</label>
        <select name="templateId" required>
          <% templates.forEach(template => { %>
            <option value="<%= template.id %>">
              <%= template.title %> - <%= template.message.substring(0,50) %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Recipient Selection -->
      <div class="form-group">
        <label>Send To:</label><br>
        <label><input type="radio" name="recipients" value="all" checked onclick="toggleUserList(false)"> All Users</label><br>
        <label><input type="radio" name="recipients" value="selected" onclick="toggleUserList(true)"> Selected Users</label>
      </div>

      <!-- User List -->
      <div id="user-list" class="user-list" style="display:none;">
        <% users.forEach(user => { %>
          <label>
            <input type="checkbox" name="recipients" value="<%= user.username %>"> <%= user.username %>
          </label><br>
        <% }) %>
      </div>

      <br>
      <button type="submit">Send Broadcast</button>
    </form>
  </div>

  <script>
    function toggleUserList(show) {
      document.getElementById("user-list").style.display = show ? "block" : "none";
    }
  </script>
</body>
</html>
